#!/usr/bin/env bash
# px4-llm-sim2hitl entry: ./runbridge <action> [options]   (./runbridge --help lists the actions)
#   ./runbridge --setup            create the Python environment (uv, from uv.lock)
#   ./runbridge --check-python     check that environment
#   ./runbridge update-model ...   model release (hitl/update.py: --generate, --rollback, --fc-only)
#   ./runbridge where [name]       this machine's paths: venv python, cache, PX4 tree, release (hitl/where.py)
# The venv lives outside the project: SIM2HITL_VENV, else the platform's user data folder + px4-llm-sim2hitl/venv.
# SIM2HITL_PYTHON overrides the interpreter.
set -euo pipefail
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if [[ $OSTYPE == darwin* ]]; then
  venv_default="$HOME/Library/Application Support/px4-llm-sim2hitl/venv"
else
  venv_default="${XDG_DATA_HOME:-$HOME/.local/share}/px4-llm-sim2hitl/venv"
fi
export UV_PROJECT_ENVIRONMENT=${SIM2HITL_VENV:-$venv_default}
py=${SIM2HITL_PYTHON:-$UV_PROJECT_ENVIRONMENT/bin/python}
if [[ ${1:-} == --setup ]]; then
  command -v uv >/dev/null || { echo "uv not found: install it first (https://docs.astral.sh/uv/)" >&2; exit 4; }
  exec uv sync --frozen --project "$script_dir"
fi
[[ -x "$py" ]] || { echo "Python environment not found: $py (run ./runbridge --setup)" >&2; exit 4; }
export PYTHONDONTWRITEBYTECODE=1
unset PYTHONHOME PYTHONPATH
case ${1:-} in
  --check-python)
    exec "$py" -B -c 'import platform,sys,serial,pymavlink,numpy; print(platform.platform()); print("Python "+sys.version.split()[0]); print("runtime Python PASS")' ;;
  update-model)
    shift; exec "$py" -B "$script_dir/hitl/update.py" "$@" ;;
  where)
    shift; exec "$py" -B "$script_dir/hitl/where.py" "$@" ;;
esac
exec "$py" -B "$script_dir/hitl/main.py" "$@"
